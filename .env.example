# Copy this file to .env and fill in your real values. Never commit .env.
#
# Two separate Paystack accounts + two separate Google Sheets for the same offer:
#  - marketplace (default): uses the PAYSTACK_* / SHEET_WEBHOOK_URL keys below -> ₦7,490
#  - ads / sales page:      uses the PAYSTACK_ADS_* / SHEET_ADS_WEBHOOK_URL keys -> ₦4,987

# Marketplace Paystack account (order amount ₦7,490)
PAYSTACK_PUBLIC_KEY=YOUR_PAYSTACK_PUBLIC_KEY_HERE
PAYSTACK_SECRET_KEY=YOUR_PAYSTACK_SECRET_KEY_HERE
PAYSTACK_AMOUNT_KOBO=749000
PAYSTACK_CURRENCY=NGN

# Ads / sales page Paystack account (separate account, separate keys) -> ₦4,987
PAYSTACK_ADS_PUBLIC_KEY=YOUR_ADS_PAYSTACK_PUBLIC_KEY_HERE
PAYSTACK_ADS_SECRET_KEY=YOUR_ADS_PAYSTACK_SECRET_KEY_HERE
PAYSTACK_ADS_AMOUNT_KOBO=498700

# Separate Google Sheets (Apps Script webhooks)
SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
SHEET_ADS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_ADS_SCRIPT_ID/exec
SITE_URL=https://nexora.tomidewilliams.com

# Supabase (partner program database)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Admin password for /admin
ADMIN_PASSWORD=CHANGE_ME
